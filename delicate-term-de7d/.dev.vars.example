FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the service-account private key on one line with literal \n for newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
ALLOWED_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# PostHog Project API Key (public — same key used in the client-side snippet).
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com
# Resend API key for the renewal-reminder cron (src/renewal.ts). Requires a
# verified sending domain in the Resend account.
RESEND_API_KEY=re_...
